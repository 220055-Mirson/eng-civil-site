# ── OBRAVIA — variáveis de ambiente ──────────────────────────
# Copiar para .env e preencher

NODE_ENV=development
PORT=3000

# Opção 1: URL completa (Render, Supabase, Neon, Railway, etc.)
DATABASE_URL=postgresql://usuario:senha@host:5432/obravia

# Opção 2: campos individuais (desenvolvimento local)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=obravia
PG_USER=postgres
PG_PASSWORD=postgres
